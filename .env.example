# TaskForce 环境变量模板:复制为 .env 后填入真实值(.env 已在 .gitignore 中,绝不入库)
# 说明:全部走 OpenAI 兼容协议;也可不填这里,改用运行后的「设置 → 模型」页填写(存 .taskforce/,同样不入库)

# ── 主模型(LLM):对话 / 路由 / 子智能体共用 ─────────────────────
# base_url 填服务根地址(多数平台以 /v1 结尾)
LLM_BASE_URL=https://your-llm-endpoint.example.com/v1
LLM_API_KEY=sk-your-llm-api-key
LLM_MODEL=your-chat-model-name
# 计费单价(元/百万 token),仅用于 /stats 的用量估算,可留 0
LLM_INPUT_PRICE_PER_M=0.0
LLM_OUTPUT_PRICE_PER_M=0.0

# ── Embedding(向量检索):知识库入库与召回用 ───────────────────
EMBEDDING_BASE_URL=https://your-embedding-endpoint.example.com/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=your-embedding-model-name

# ── 数据库:PostgreSQL + pgvector(默认对应 docker-compose.yml 的 5433)──
DATABASE_URL=postgresql://taskforce:taskforce@127.0.0.1:5433/taskforce

# ── 执行沙箱:自建远程 Docker 服务(不填即禁用代码执行能力)────────
SANDBOX_URL=http://127.0.0.1:8000
SANDBOX_API_KEY=your-sandbox-api-key

# ── 联网调研:AnySearch(留空走匿名调用,按 IP 限流)──────────────
ANYSEARCH_API_KEY=

# ── 日志级别:DEBUG / INFO / WARNING / ERROR ───────────────────
LOG_LEVEL=INFO
