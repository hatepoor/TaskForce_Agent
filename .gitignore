# ─────────────────────────────────────────────────────────────
# 密钥与本地运行数据(绝不入库)
# ─────────────────────────────────────────────────────────────
# 真实密钥:LLM / Embedding / 数据库 / 沙箱 / 搜索 API(键名见 .env.example)
/.env
/.env.*
!/.env.example
# Vite 本地覆盖(常写真实后端地址):.env.development 是共享配置,照常入库
.env*.local

# MCP 服务器配置:headers/env 里带真实密钥与内网地址(示例见 mcp_config.example.json)
/mcp_config.json

# 用户个人背景:常写真实姓名/年龄/身份等个人信息,绝不入库(模板见 agents.example.md)
/agents.md

# 本地状态目录:.taskforce/ 存当前会话与模型覆盖(settings/session.py、model_overrides.py)
/.taskforce/
# 本地工具状态
/.omo/

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
develop-eggs/
.venv/
venv/

# ─────────────────────────────────────────────────────────────
# 前端(Node / Vite)
# ─────────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
coverage/

# ─────────────────────────────────────────────────────────────
# IDE / 编辑器
# ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─────────────────────────────────────────────────────────────
# 缓存与日志
# ─────────────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.log

# ─────────────────────────────────────────────────────────────
# 系统杂项
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
